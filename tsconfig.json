{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["playground/src/*"]
    }
  },
  "include": ["src/cloud-storage", "src/types.ts", "tests", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "public", "registry"]
}
